# Server
N2A_PORT=9998
N2A_SERVER_HOST=127.0.0.1
N2A_SERVER_PORT=9998

# Bootstrap admin for first startup. Change before deploying.
N2A_BOOTSTRAP_ADMIN_USERNAME=admin
N2A_BOOTSTRAP_ADMIN_PASSWORD=change-me-please

# Optional bootstrap API key. Leave empty and create keys in the admin console
# for normal deployments.
N2A_BOOTSTRAP_API_KEY=

# Database
N2A_DATABASE_DRIVER=sqlite
N2A_DATABASE_DSN=data/notion2api.sqlite

# Frontend and Docker Compose
N2A_FRONTEND_PORT=5173
N2A_FRONTEND_API_BASE_URL=/api

# Optional PostgreSQL profile
POSTGRES_PASSWORD=change-me
